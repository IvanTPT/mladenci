---
const { data } = Astro.props;
---
<section class="section">
  <div class="section__inner w-full max-w-6xl mx-auto px-4">
    <h2 class="section__title">План и програм</h2>
    
    <div class="plan-grid">
      <!-- ЛЕВА СТРАНА: План -->
      <div class="schedule-list">
        {data.lokacije.map((stavka: any) => (
          <div class="schedule-item">
            <!-- Време, црта и наслов сада стоје у једној линији -->
            <div class="schedule-header">
              <span class="time">{stavka.vreme}</span>
              <span class="separator">—</span>
              <h3>{stavka.naziv}</h3>
            </div>
            
            <div class="details">
              <p>{stavka.opis}</p>
            </div>
          </div>
        ))}
      </div>
      
      <!-- ДЕСНА СТРАНА: Мапа -->
      <div class="map-container">
        <iframe 
          src={data.mapa_embed} 
          allowfullscreen="" 
          loading="lazy">
        </iframe>
      </div>
    </div>

  </div>
</section>

<style>
  /* === ГЛАВНИ GRID ЗА РАСПОРЕД === */
  .plan-grid {
    display: grid;
    grid-template-columns: 1fr; 
    gap: 2rem;
    align-items: stretch; /* Гарантује исту висину леве и десне стране */
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .plan-grid {
      grid-template-columns: 1fr 1fr; 
      gap: 3rem;
    }
  }

  /* === СТИЛОВИ ЗА ЛЕВУ СТРАНУ (ПЛАН) === */
  .schedule-list {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

/* Измени постојећу schedule-item класу */
  .schedule-item {
    background: rgba(255, 255, 255, 0.85);
    padding: 1.5rem;
    border-radius: 1rem;
    border-left: 4px solid var(--color-accent);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    
    /* ДОДАТО ЗА АНИМАЦИЈУ: Почетно стање је невидљиво и спуштено */
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  /* ДОДАТО: Стање када постане видљиво */
  .schedule-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Опционо: задржи ховер ефекат али га раздвој */
  .schedule-item.is-visible:hover {
    transform: translateX(10px);
  }

  /* НОВО: Заједнички ред за време и наслов */
  .schedule-header {
    display: flex;
    align-items: baseline; /* Поравнава доње ивице текста */
    gap: 0.75rem; /* Размак између времена, црте и наслова */
    margin-bottom: 0.5rem;
    flex-wrap: wrap; /* Заштита за веома мале екране телефона */
  }

  .time {
    font-weight: bold;
    color: var(--color-accent);
    font-size: 1.5rem;
  }

  .separator {
    color: var(--color-accent);
    font-weight: bold;
    opacity: 0.7;
  }

  .schedule-header h3 {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-primary);
    margin: 0; /* Маргина је уклоњена јер је сада хендлује schedule-header */
  }

  .details p {
    color: var(--color-text-dark);
    opacity: 0.8;
    line-height: 1.6;
    margin: 0;
  }

  /* === СТИЛОВИ ЗА ДЕСНУ СТРАНУ (МАПА) === */
/* Измени постојећу map-container класу */
  .map-container {
    /* ... твоји постојећи стилови за мапу ... */
    
    /* ДОДАТО ЗА АНИМАЦИЈУ */
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .map-container.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  
  .map-container iframe {
    position: absolute; 
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
<script>
  const scheduleItems = document.querySelectorAll('.schedule-item');
  const mapContainer = document.querySelector('.map-container');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        // Додајемо благо кашњење за сваку следећу ставку (stagger ефекат)
        setTimeout(() => {
          entry.target.classList.add('is-visible');
        }, index * 100); 
      }
    });
  }, { threshold: 0.1 });

  scheduleItems.forEach(item => observer.observe(item));
  if (mapContainer) observer.observe(mapContainer);
</script>
