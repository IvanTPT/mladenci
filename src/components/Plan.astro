---
const { data } = Astro.props;
---
<section class="section">
  <div class="section__inner w-full max-w-6xl mx-auto px-4">
    <h2 class="section__title">План и програм</h2>
    
    <div class="plan-grid">
      <!-- ЛЕВА СТРАНА: План -->
      <div class="schedule-list">
        {data.lokacije.map((stavka: any) => (
          <div class="schedule-item">
            <div class="time">{stavka.vreme}</div>
            <div class="details">
              <h3>{stavka.naziv}</h3>
              <p>{stavka.opis}</p>
            </div>
          </div>
        ))}
      </div>
      
      <!-- ДЕСНА СТРАНА: Мапа -->
      <div class="map-container">
        <iframe 
          src={data.mapa_embed} 
          allowfullscreen="" 
          loading="lazy">
        </iframe>
      </div>
    </div>

  </div>
</section>

<style>
  /* === GLAVNI GRID ZA RASPORED === */
  .plan-grid {
    display: grid;
    grid-template-columns: 1fr; /* Za mobilne telefone: 1 kolona (jedno ispod drugog) */
    gap: 2rem;
    align-items: stretch; /* OVO garantuje da su leva i desna strana iste visine! */
    margin-top: 2.5rem;
  }

  /* Za tablete i kompjutere (širina ekrana veća od 768px) */
  @media (min-width: 768px) {
    .plan-grid {
      grid-template-columns: 1fr 1fr; /* Na silu deli u 2 jednake kolone */
      gap: 3rem;
    }
  }

  /* === STILOVI ZA LEVU STRANU (PLAN) === */
  .schedule-list {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  .schedule-item {
    background: rgba(255, 255, 255, 0.85);
    padding: 1.5rem;
    border-radius: 1rem;
    border-left: 4px solid var(--color-accent);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
  }

  .schedule-item:hover {
    transform: translateX(10px);
  }

  .time {
    font-weight: bold;
    color: var(--color-accent);
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .details h3 {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .details p {
    color: var(--color-text-dark);
    opacity: 0.8;
    line-height: 1.6;
    margin: 0;
  }

  /* === STILOVI ZA DESNU STRANU (MAPA) === */
  .map-container {
    background: rgba(255, 255, 255, 0.85);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid rgba(181, 141, 104, 0.3);
    min-height: 350px; /* Minimalna visina za svaki slučaj */
    position: relative; /* Bitno za iframe */
    width: 100%;
  }
  
  .map-container iframe {
    position: absolute; /* Rasteže iframe tačno na dimenzije kontejnera */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
