---
const { data } = Astro.props;
---
<section class="section">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-6xl mx-auto px-4">
    <!-- Лева страна: План -->
    <div class="schedule-list">
      <h2 class="text-4xl mb-8 font-display">План и програм</h2>
      {data.lokacije.map((stavka: any) => (
        <div class="schedule-item mb-6 flex gap-4">
          <div class="time font-bold text-accent text-xl">{stavka.vreme}</div>
          <div class="details">
            <h3 class="text-lg font-bold">{stavka.naziv}</h3>
            <p class="text-gray-600">{stavka.opis}</p>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Десна страна: Мапа -->
    <div class="map-container rounded-xl overflow-hidden shadow-lg h-96 md:h-auto">
      <iframe src={data.mapa_embed} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </div>
  </div>
</section>
